# so expired alerts stop showing in DR Ahora/Home using the same lifecycle
# rules already used by DR Radar. No Radar backend, FCM, Railway, DR Audio,
# notification or unrelated Home logic is changed.

--- a/app/src/main/java/com/draccesoriosrd/app/HomeActivity.kt
+++ b/app/src/main/java/com/draccesoriosrd/app/HomeActivity.kt
@@ -1625,13 +1625,15 @@
                 this
             )
 
         val radarAlerts =
             radarSnapshot
-                ?.alerts
-                ?.filter {
-                    it.active
+                ?.let {
+                    RadarCacheStore.getVisibleAlerts(
+                        this,
+                        it
+                    )
                 }
                 .orEmpty()
 
         val highlightedAlert =
             radarAlerts
